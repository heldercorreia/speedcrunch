# if defined(UNDER_CE)
#  include <winbase.h>
# else
#  include <winver.h>
# endif

SPEEDCRUNCH_ICON ICON DISCARDABLE "@CMAKE_CURRENT_SOURCE_DIR@/resources/speedcrunch.ico"

VS_VERSION_INFO VERSIONINFO
	FILEVERSION @speedcrunch_VERSION_RC@
	PRODUCTVERSION @speedcrunch_VERSION_RC@
	FILEFLAGSMASK 0x3fL
#ifdef _DEBUG
	FILEFLAGS VS_FF_DEBUG
#else
	FILEFLAGS 0x0L
#endif
	FILEOS VOS__WINDOWS32
	FILETYPE VFT_APP
	FILESUBTYPE 0x0L
	BEGIN
		BLOCK "StringFileInfo"
		BEGIN
			BLOCK "040904B0"
			BEGIN
				VALUE "CompanyName", "SpeedCrunch developers\0"
				VALUE "FileVersion", "@speedcrunch_VERSION@\0"
				VALUE "ProductVersion", "@speedcrunch_VERSION@\0"
				VALUE "LegalCopyright", "Copyright 2004-2026 SpeedCrunch developers\0"
			END
		END
	END
/* End of Version info */
