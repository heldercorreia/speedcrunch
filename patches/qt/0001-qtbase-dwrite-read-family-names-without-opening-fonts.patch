From: Helder Correia <heldercorreia@users.noreply.github.com>
Subject: [PATCH] Windows: read DirectWrite family names without opening fonts

populateFontDatabase() created an IDWriteFont for every installed font to
read its GDI-compatible and typographic family names. Creating a font opens
its file, so on a cold start with many fonts installed this blocked the
first use of any font for seconds: 8.7 s for 2681 fonts on Windows 11.

Read the same names from the font set of each family instead. Its
properties come from the system font cache. On the same machine and cold
start this took 11.6 ms and registered the same 1777 family names.

The style names collectAdditionalNames() also read were not used here.
---
--- a/src/gui/text/windows/qwindowsdirectwritefontdatabase.cpp
+++ b/src/gui/text/windows/qwindowsdirectwritefontdatabase.cpp
@@ -725,13 +725,36 @@ void QWindowsDirectWriteFontDatabase::populateFontDatabase()
                         registerFamily(englishLocaleName, QString{});
                 }
 
-                for (uint j = 0; j < fontFamily->GetFontCount(); ++j) {
-                    DirectWriteScope<IDWriteFont3> font;
-                    if (SUCCEEDED(fontFamily->GetFont(j, &font))) {
-                        collectAdditionalNames(*font,
-                                               hasDefaultLocale ? defaultLocale : nullptr,
-                                               englishLocale,
-                                               registerFamily);
+                // Read the GDI-compatible and typographic family names of each font
+                // from the family's font set. Font set properties come from the
+                // system font cache, while creating an IDWriteFont for every font
+                // opens its file, which takes seconds on a cold start when many
+                // fonts are installed. The style names are not needed here.
+                DirectWriteScope<IDWriteFontSet1> fontSet;
+                if (SUCCEEDED(fontFamily->GetFontSet(&fontSet))) {
+                    IDWriteFontSet *familyFonts = *fontSet;
+                    const DWRITE_FONT_PROPERTY_ID nameProperties[] = {
+                        DWRITE_FONT_PROPERTY_ID_WIN32_FAMILY_NAME,
+                        DWRITE_FONT_PROPERTY_ID_TYPOGRAPHIC_FAMILY_NAME
+                    };
+                    for (uint j = 0; j < familyFonts->GetFontCount(); ++j) {
+                        for (const DWRITE_FONT_PROPERTY_ID property : nameProperties) {
+                            BOOL exists = FALSE;
+                            DirectWriteScope<IDWriteLocalizedStrings> familyNames;
+                            if (FAILED(familyFonts->GetPropertyValues(j, property, &exists, &familyNames))
+                                || !exists || *familyNames == nullptr) {
+                                continue;
+                            }
+
+                            const QString englishName = localeString(*familyNames, englishLocale);
+                            if (!englishName.isEmpty())
+                                registerFamily(englishName, QString{});
+                            if (hasDefaultLocale) {
+                                const QString defaultName = localeString(*familyNames, defaultLocale);
+                                if (!defaultName.isEmpty())
+                                    registerFamily(defaultName, QString{});
+                            }
+                        }
                     }
                 }
             }
